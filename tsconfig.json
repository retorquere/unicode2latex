{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowUnreachableCode": false,
    "declaration": true,
    "importHelpers": true,
    "target": "es2017",
    "disableSizeLimit": true,
    "noImplicitAny": false,
    "removeComments": true,
    "preserveConstEnums": false,
    "sourceMap": false,
    "downlevelIteration": true,
    "lib": [ "es2017", "dom" ],
    "typeRoots": [
      "./typings",
      "./node_modules/@types"
    ]
  },
  "include": [
    "*.ts",
    "tables/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "typings",
    "docs"
  ]
}
