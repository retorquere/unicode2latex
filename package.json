{
  "name": "unicode2latex",
  "version": "7.0.17",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "keywords": [
    "TeX",
    "LaTeX",
    "unicode"
  ],
  "description": "Mapping to convert unicode characters from and to LaTeX macros",
  "scripts": {
    "test": "npm start && jest",
    "start": "npm run build",
    "prebuild": "./build.js && find tables -type f",
    "build": "run-p --aggregate-output lint tsc docs",
    "lint": "dprint fmt *.ts *.js && dprint check *.ts",
    "tsc:esm": "rm -rf dist/esm && tsc -d -p tsconfig.esm.json",
    "tsc:cjs": "rm -rf dist/cjs && tsc -d -p tsconfig.cjs.json",
    "tsc": "npm run tsc:esm && npm run tsc:cjs",
    "docs": "typedoc --tsconfig tsconfig.esm.json --gitRevision --out docs --readme README.md index.ts",
    "preversion": "npm start",
    "postversion": "git push --tags && git push"
  },
  "author": "Emiliano Heyns",
  "license": "ISC",
  "files": [
    "package.json",
    "package-lock.json",
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^24.8.1",
    "better-sqlite3": "^12.4.1",
    "csv-parse": "^6.1.0",
    "dprint": "^0.50.2",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "json-merge-patch": "^1.0.2",
    "json-squash": "^0.0.3",
    "json-stringify-pretty-compact": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "papaparse": "^5.5.3",
    "stringify-object": "^6.0.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retorquere/unicode2latex.git"
  },
  "homepage": "https://github.com/retorquere/unicode2latex.git",
  "dependencies": {
    "@pomgui/deep": "^3.0.3",
    "tiny-merge-patch": "^0.1.2"
  }
}
