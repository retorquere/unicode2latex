{
  "name": "unicode2latex",
  "version": "7.0.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "keywords": [
    "TeX",
    "LaTeX",
    "unicode"
  ],
  "description": "Mapping to convert unicode characters from and to LaTeX macros",
  "scripts": {
    "test": "npm start && jest",
    "start": "npm run build",
    "prebuild": "make build && ./build",
    "build": "run-p --aggregate-output lint tsc docs",
    "lint": "dprint fmt *.ts && dprint check *.ts",
    "tsc:esm": "rm -rf dist/esm && tsc -d -p tsconfig.esm.json",
    "tsc:cjs": "rm -rf dist/cjs && tsc -d -p tsconfig.cjs.json",
    "tsc": "npm run tsc:esm && npm run tsc:cjs",
    "docs": "typedoc --tsconfig tsconfig.esm.json --gitRevision --out docs --readme README.md index.ts",
    "preversion": "npm start",
    "postversion": "git push --tags && git push"
  },
  "author": "Emiliano Heyns",
  "license": "ISC",
  "files": [
    "package.json",
    "package-lock.json",
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^22.15.29",
    "dprint": "^0.50.0",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "papaparse": "^5.5.3",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retorquere/unicode2latex.git"
  },
  "homepage": "https://github.com/retorquere/unicode2latex.git"
}
